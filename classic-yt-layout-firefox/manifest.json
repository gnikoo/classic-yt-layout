{
  "manifest_version": 2,
  "name": "Classic YT Layout",
  "version": "3.2.2",
  "description": "Restores the classic YouTube player layout, reverting the 2025/2026 UI change.",
  "author": "Classic YT Layout",
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  },
  "browser_action": {
    "default_icon": {
      "48": "icons/icon48.png",
      "96": "icons/icon96.png"
    },
    "default_popup": "popup.html",
    "default_title": "Classic YT Layout"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "permissions": [
    "storage",
    "tabs",
    "*://www.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/watch*"],
      "js": ["content.js"],
      "css": ["volume-fix.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://www.youtube.com/embed/*"],
      "js": ["content.js"],
      "css": ["volume-fix.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "classic-yt-layout@extension",
      "strict_min_version": "109.0"
    }
  }
}
